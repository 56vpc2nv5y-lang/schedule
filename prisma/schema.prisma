generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SELF_CHECK
  LEADER_REVIEW
  WAITING_EXTERNAL
  READY_TO_SEND
  DONE
  TODO
  WAITING
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Every task has a single originating workflow. Source records remain the
/// authority for checklist-backed tasks; this is only the shared task index.
enum TaskSource {
  MANUAL
  PROJECT_STAGE
  TRAINING_CHECKLIST
  RECEPTION_CHECKLIST
  FEEDBACK_FOLLOW_UP
}

enum ProjectContactSide {
  OUR_TEAM
  CLIENT
  SUPPLIER
}

enum TaskContactPurpose {
  CLIENT_CONTACT
  SUPPLIER_CONTACT
  INFORMED
  VISITOR
}

enum FileStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum MeetingReviewStatus {
  IN_PROGRESS
  FINALIZED
  ARCHIVED
}

enum ReviewRoundStatus {
  PENDING
  SENT
  FEEDBACK_RECEIVED
  FINALIZED
}

enum ReceptionType {
  VISIT
  EXHIBITION_INVITE
  BUSINESS_TRIP
}

enum ReceptionStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

enum TagType {
  REGION
  PROJECT_TYPE
  TASK_TYPE
}

enum TemplateType {
  INVITATION
  EMAIL
  DOCUMENT
}

enum DisplayMode {
  ZH
  BILINGUAL
}

/// 椤圭洰锛氫竴涓妧鏈悎浣滈」鐩殑涓昏〃
model Project {
  id               String        @id @default(cuid())
  nameZh           String
  nameEn           String?
  clientName       String
  status           ProjectStatus @default(ACTIVE)
  plannedStart     DateTime?
  plannedEnd       DateTime?
  note             String?
  regionTagId      String?
  projectTypeTagId String?
  stageTemplateId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  regionTag         Tag?               @relation("ProjectRegion", fields: [regionTagId], references: [id], onDelete: SetNull)
  projectTypeTag    Tag?               @relation("ProjectType", fields: [projectTypeTagId], references: [id], onDelete: SetNull)
  stageTemplate     StageTemplate?     @relation("ProjectStageTemplate", fields: [stageTemplateId], references: [id], onDelete: SetNull)
  contacts          ProjectContact[]
  stages            ProjectStage[]
  tasks             Task[]
  files             ProjectFile[]
  meetingReviews    MeetingReview[]
  timelineEvents    TimelineEvent[]
  receptions        Reception[]
  growthLogs        GrowthLog[]
  resumePoints      ResumePoint[]
  knowledgeNotes    KnowledgeNote[]
  feedbackQuestions FeedbackQuestion[]
  scheduleBlocks    ScheduleBlock[]
  trainingProfile   TrainingProfile?

  @@index([status])
  @@index([regionTagId])
  @@index([projectTypeTagId])
}

/// 鍩硅椤圭洰涓撶敤鍙拌处锛氶€氱敤 Project 涔嬪鐨勪笟鍔″瓧娈?
model TrainingProfile {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  currentPhase           String   @default("璇剧▼澶х翰")
  clientContactName      String?
  clientContactInfo      String?
  topicSource            String?
  topicCount             Int?
  participantCount       Int?
  totalDays              Float?
  dailyHours             Float?
  location               String?
  budget                 Float?
  currency               String   @default("CNY")
  costOwnership          String?
  internalCostNote       String?
  quoteRound             Int      @default(1)
  internalContractStatus String?
  clientContractStatus   String?
  depositNote            String?
  prepaymentPercent      Float?
  paymentMilestones      String?
  reportingStatus        String?
  postponed              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItems TrainingChecklistItem[]

  @@index([currentPhase])
  @@index([postponed])
}

model TrainingChecklistItem {
  id                String   @id @default(cuid())
  trainingProfileId String
  section           String
  label             String
  done              Boolean  @default(false)
  note              String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainingProfile TrainingProfile @relation(fields: [trainingProfileId], references: [id], onDelete: Cascade)

  @@unique([trainingProfileId, section, label])
  @@index([trainingProfileId, section, sortOrder])
}

/// 鑱旂郴浜哄簱锛氭墍鏈夆€滀汉鈥濈殑鍞竴鏁版嵁婧愶紝鍒鍙紩鐢ㄥ叾 id
model Contact {
  id           String   @id @default(cuid())
  name         String
  organization String
  title        String?
  email        String?
  wechat       String?
  note         String?
  regionTagId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  regionTag         Tag?                 @relation("ContactRegion", fields: [regionTagId], references: [id], onDelete: SetNull)
  roles             ContactRoleMap[]
  projects          ProjectContact[]
  assignedTasks     Task[]               @relation("TaskAssignee")
  taskContacts      TaskContact[]
  stageContacts     StageContact[]
  receptionVisitors ReceptionVisitor[]
  teamMemberProfile TeamMemberProfile?
  sentRounds        MeetingReviewRound[] @relation("MeetingRoundSender")
  receivedRounds    MeetingReviewRound[] @relation("MeetingRoundReceiver")

  @@index([regionTagId])
}

model ContactRole {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  contacts ContactRoleMap[]
}

model ContactRoleMap {
  contactId String
  roleId    String

  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role    ContactRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([contactId, roleId])
}

model TeamMemberProfile {
  id           String  @id @default(cuid())
  contactId    String  @unique
  active       Boolean @default(true)
  capacityNote String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
}

model ProjectContact {
  id        String             @id @default(cuid())
  projectId String
  contactId String
  side      ProjectContactSide
  isPrimary Boolean            @default(false)
  note      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([projectId, contactId, side])
  @@index([projectId, side])
}

model StageTemplate {
  id               String   @id @default(cuid())
  name             String
  description      String?
  isDefault        Boolean  @default(false)
  projectTypeTagId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectTypeTag Tag?                @relation("StageTemplateProjectType", fields: [projectTypeTagId], references: [id], onDelete: SetNull)
  items          StageTemplateItem[]
  projects       Project[]           @relation("ProjectStageTemplate")
}

model StageTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  name        String
  sortOrder   Int
  description String?

  template      StageTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  projectStages ProjectStage[]

  @@unique([templateId, sortOrder])
}

/// 椤圭洰闃舵锛氭寜妯℃澘鐢熸垚锛屽彲鍗曠嫭鏀规湡/鏀圭姸鎬侊紙鐢樼壒鍥炬嫋鍔ㄦ敼杩欓噷锛?
model ProjectStage {
  id                   String      @id @default(cuid())
  projectId            String
  sourceTemplateItemId String?
  name                 String
  sortOrder            Int
  plannedStart         DateTime?
  plannedEnd           DateTime?
  actualCompleted      DateTime?
  status               StageStatus @default(NOT_STARTED)
  note                 String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTemplateItem StageTemplateItem? @relation(fields: [sourceTemplateItemId], references: [id], onDelete: SetNull)
  tasks              Task[]
  files              ProjectFile[]
  contacts           StageContact[]
  meetingReviews     MeetingReview[]

  @@unique([projectId, sortOrder])
  @@index([projectId, status])

}

model StageContact {
  stageId   String
  contactId String
  roleNote  String?

  stage   ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([stageId, contactId])
}

model Task {
  id          String     @id @default(cuid())
  /// 鍙负绌猴細涓嶆寕椤圭洰鐨勪釜浜?琛屾斂浜嬪姟锛堟姤閿€銆佸叆鑱屾墜缁瓑锛?
  projectId   String?
  stageId     String?
  typeTagId   String?
  title       String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  waitingOn   String?
  sendChannel String?
  originalStatusNote String?
  priority    Priority   @default(MEDIUM)
  source      TaskSource @default(MANUAL)
  sourceRefId String?
  sourceLabel String?
  dueDate     DateTime?
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage            ProjectStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  typeTag          Tag?              @relation("TaskType", fields: [typeTagId], references: [id], onDelete: SetNull)
  assignee         Contact?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contacts         TaskContact[]
  feedbackFollowUp FeedbackQuestion? @relation("FeedbackFollowUp")

  @@unique([source, sourceRefId])
  @@index([projectId, status])
  @@index([stageId])
  @@index([assigneeId])
  @@index([source, status])
}

model TaskContact {
  taskId    String
  contactId String
  purpose   TaskContactPurpose

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([taskId, contactId, purpose])
}

model ProjectFile {
  id         String     @id @default(cuid())
  projectId  String
  stageId    String?
  fileTypeId String?
  name       String
  version    String?
  status     FileStatus @default(DRAFT)
  url        String?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage               ProjectStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  fileType            FileType?       @relation(fields: [fileTypeId], references: [id], onDelete: SetNull)
  finalForMeetingRuns MeetingReview[] @relation("FinalMeetingFile")

  @@index([projectId])
  @@index([stageId])
}

model MeetingReview {
  id          String              @id @default(cuid())
  projectId   String
  stageId     String?
  title       String
  status      MeetingReviewStatus @default(IN_PROGRESS)
  finalFileId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  finalFile ProjectFile?         @relation("FinalMeetingFile", fields: [finalFileId], references: [id], onDelete: SetNull)
  rounds    MeetingReviewRound[]
}

model MeetingReviewRound {
  id                String            @id @default(cuid())
  reviewId          String
  roundNo           Int
  senderContactId   String?
  receiverContactId String?
  sentAt            DateTime?
  feedback          String?
  status            ReviewRoundStatus @default(PENDING)
  finalizedAt       DateTime?

  review   MeetingReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sender   Contact?      @relation("MeetingRoundSender", fields: [senderContactId], references: [id], onDelete: SetNull)
  receiver Contact?      @relation("MeetingRoundReceiver", fields: [receiverContactId], references: [id], onDelete: SetNull)

  @@unique([reviewId, roundNo])
}

/// 鍑哄樊/鎺ュ緟/灞曚細瀹夋帓锛坱ype 鍖哄垎涓夌被锛?
model Reception {
  id        String          @id @default(cuid())
  projectId String?
  type      ReceptionType
  title     String
  location  String?
  purpose   String?
  startAt   DateTime?
  endAt     DateTime?
  status    ReceptionStatus @default(PLANNED)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  visitors       ReceptionVisitor[]
  checklistItems ReceptionChecklistItem[]
}

/// 鎺ュ緟娓呭崟鏉＄洰锛氭寜闃舵锛堣鍓嶅噯澶?鎶佃揪涓庣幇鍦?閫佽锛夎窡韪瘡涓€椤瑰噯澶囧伐浣?
model ReceptionChecklistItem {
  id          String    @id @default(cuid())
  receptionId String
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  phase       String // 琛屽墠鍑嗗 / 鎶佃揪涓庣幇鍦?/ 閫佽
  title       String
  done        Boolean   @default(false)
  ownerId     String? // 寮曠敤 Contact id锛堟澗寮曠敤锛屽彲绌猴級
  dueDate     String? // ISO yyyy-mm-dd
  note        String?
  isMine      Boolean   @default(false) // 銆屾垜鐨勩€嶉珮浜?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([receptionId])
}

model ReceptionVisitor {
  receptionId String
  contactId   String

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([receptionId, contactId])
}

model TimelineEvent {
  id         String   @id @default(cuid())
  projectId  String
  entityType String
  entityId   String?
  action     String
  message    String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Tag {
  id        String  @id @default(cuid())
  type      TagType
  name      String
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  projectsByRegion Project[]       @relation("ProjectRegion")
  projectsByType   Project[]       @relation("ProjectType")
  contactsByRegion Contact[]       @relation("ContactRegion")
  tasksByType      Task[]          @relation("TaskType")
  stageTemplates   StageTemplate[] @relation("StageTemplateProjectType")

  @@unique([type, name])
}

model FileType {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  files ProjectFile[]
}

model TextTemplate {
  id        String       @id @default(cuid())
  name      String
  type      TemplateType
  content   String
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// 杩愯鏃堕厤缃紙鐧诲綍瀵嗙爜銆丄I 瀵嗛挜绛夛級锛氫紭鍏堣杩欓噷锛屽洖閫€鍒扮幆澧冨彉閲忋€?/// 杩欐牱闈炴妧鏈敤鎴峰彲浠ュ湪銆岃缃€嶉〉鏀归厤缃紝涓嶇敤纰?.env / Vercel 鐜鍙橀噺銆?
model AppSetting {
  id        String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AppPreference {
  id          String      @id @default("singleton")
  displayMode DisplayMode @default(ZH)
  updatedAt   DateTime    @updatedAt
}

/// 鐭ヨ瘑搴擄細鎸変富棰樼Н绱笓涓氱煡璇嗭紙涓井瀛?澶但鍏?鑽у厜妫€娴嬧€︼級锛屽彲鍏宠仈椤圭洰
model KnowledgeNote {
  id        String   @id @default(cuid())
  topic     String // 涓婚/棰嗗煙锛屽銆屽お璧吂銆嶃€岀數鍔ㄦ苯杞︾淮淇濄€?
  title     String
  content   String // 鐭ヨ瘑姝ｆ枃/瑕佺偣/鏈瀵圭収
  url       String? // 澶栭儴璧勬枡閾炬帴
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([topic])
}

enum QuestionStatus {
  ORGANIZING
  TO_SUPPLIER
  WAITING_SUPPLIER
  EDITING_REVIEW
  LEADER_REVIEW
  TRANSLATION
  TO_CLIENT
  SENT_CLIENT
  OPEN
  SENT
  ANSWERED
  UNCLEAR
  NEED_MEETING
  CONFIRMED
}

/// 闂鍙嶉娓呭崟锛氱敳鏂规彁闂啋鏁寸悊鍙戜緵搴斿晢鈫掑垽鏂洖澶嶁啋杩介棶/寮€浼氣啋纭锛岄€愭潯璺熻釜
model FeedbackQuestion {
  id             String         @id @default(cuid())
  projectId      String
  source         String         @default("鐢叉柟") // 鐢叉柟 / 渚涘簲鍟?/ 鎴戞柟
  question       String
  answer         String?
  note           String? // 杩介棶鐐?寰呯‘璁ょ偣
  followUpTaskId String?        @unique
  status         QuestionStatus @default(ORGANIZING)
  background     String?
  supplierQuestion String?
  supplierReply  String?
  sunnyJudgment  String?
  followUpLog    String?
  finalReplyZh   String?
  finalReplyEn   String?
  internalNote   String?
  ownerContactId String?
  dueAt          DateTime?
  questionAt     DateTime?
  plannedSupplierSendAt DateTime?
  supplierSentAt DateTime?
  expectedReplyAt DateTime?
  actualReplyAt  DateTime?
  leaderReviewedAt DateTime?
  translatedAt   DateTime?
  clientSentAt   DateTime?
  archivedAt     DateTime?
  sendChannel    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  followUpTask Task?   @relation("FeedbackFollowUp", fields: [followUpTaskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([archivedAt])
}

/// 鍛ㄨ鍒掓椂闂村潡锛氭棩鏈?脳 灏忔椂鐨勬棩绋嬶紙date 涓虹┖ = 姣忓ぉ閲嶅鐨勪緥琛屽畨鎺掞級
model ScheduleBlock {
  id           String    @id @default(cuid())
  title        String
  date         DateTime? // 鍏蜂綋鏌愬ぉ锛沶ull = 姣忔棩渚嬭锛堣捣搴?閫氬嫟/鍗堜紤鈥︼級
  startMin     Int // 浠?0:00 璧风殑鍒嗛挓鏁帮紝濡?7:30 = 450
  endMin       Int
  kind         String    @default("work") // routine 渚嬭 / work 宸ヤ綔
  location     String? // 鍦扮偣
  participants String? // 鍙備笌浜猴紙鑷敱鏂囨湰锛岄€楀彿鍒嗛殧锛?
  note         String? // 澶囨敞 / 鎴戠殑浠诲姟
  projectId    String? // 鍙€夊叧鑱旈」鐩?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([date])
}

enum MoneyKind {
  SALARY // 宸ヨ祫鍒拌处
  ADVANCE // 鍨粯锛堝緟鎶ラ攢锛?
  REIMBURSED // 鎶ラ攢鍒拌处
  OTHER // 鍏朵粬鏀舵敮
}

/// 璐㈠姟璁板綍锛氬伐璧勩€佸嚭宸灚浠樸€佹姤閿€鍥炴
model MoneyRecord {
  id         String    @id @default(cuid())
  kind       MoneyKind @default(ADVANCE)
  amount     Float // 閲戦锛堟鏁帮級锛屾柟鍚戠敱 kind 鍐冲畾
  currency   String    @default("CNY")
  happenedAt DateTime  @default(now())
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([kind])
}

enum GrowthCategory {
  ACHIEVEMENT // 鎴愭灉浜偣锛堝彲鐩存帴鍐欒繘绠€鍘嗭級
  SKILL // 鎶€鑳界Н绱?
  LESSON // 澶嶇洏/鏁欒
  CERTIFICATE // 璇佷功/鍩硅
  NETWORK // 浜鸿剦璧勬簮
}

/// 鎴愰暱妗ｆ锛氫负鑱屼笟鍙戝睍/璺虫Ы绉疮绱犳潗锛屽彲閫夊叧鑱旈」鐩?
model GrowthLog {
  id         String         @id @default(cuid())
  category   GrowthCategory @default(ACHIEVEMENT)
  title      String
  detail     String?
  projectId  String?
  happenedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([category])
}

/// 宸茬‘璁ょ殑涓嫳鏂囩畝鍘嗚鐐癸細鐢?AI 瀵硅瘽鎴栨墜宸ユ暣鐞嗗悗鏀惰棌锛屽彲鍏宠仈椤圭洰澶嶇敤銆?
model ResumePoint {
  id         String   @id @default(cuid())
  title      String
  chinese    String
  english    String
  sourceNote String?
  projectId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([updatedAt])
}

