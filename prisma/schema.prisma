generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Every task has a single originating workflow. Source records remain the
/// authority for checklist-backed tasks; this is only the shared task index.
enum TaskSource {
  MANUAL
  PROJECT_STAGE
  TRAINING_CHECKLIST
  RECEPTION_CHECKLIST
  FEEDBACK_FOLLOW_UP
}

enum ProjectContactSide {
  OUR_TEAM
  CLIENT
  SUPPLIER
}

enum TaskContactPurpose {
  CLIENT_CONTACT
  SUPPLIER_CONTACT
  INFORMED
  VISITOR
}

enum FileStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum MeetingReviewStatus {
  IN_PROGRESS
  FINALIZED
  ARCHIVED
}

enum ReviewRoundStatus {
  PENDING
  SENT
  FEEDBACK_RECEIVED
  FINALIZED
}

enum ReceptionType {
  VISIT
  EXHIBITION_INVITE
  BUSINESS_TRIP
}

enum ReceptionStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

enum TagType {
  REGION
  PROJECT_TYPE
  TASK_TYPE
}

enum TemplateType {
  INVITATION
  EMAIL
  DOCUMENT
}

enum DisplayMode {
  ZH
  BILINGUAL
}

/// 项目：一个技术合作项目的主表
model Project {
  id               String        @id @default(cuid())
  nameZh           String
  nameEn           String?
  clientName       String
  status           ProjectStatus @default(ACTIVE)
  plannedStart     DateTime?
  plannedEnd       DateTime?
  note             String?
  regionTagId      String?
  projectTypeTagId String?
  stageTemplateId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  regionTag         Tag?               @relation("ProjectRegion", fields: [regionTagId], references: [id], onDelete: SetNull)
  projectTypeTag    Tag?               @relation("ProjectType", fields: [projectTypeTagId], references: [id], onDelete: SetNull)
  stageTemplate     StageTemplate?     @relation("ProjectStageTemplate", fields: [stageTemplateId], references: [id], onDelete: SetNull)
  contacts          ProjectContact[]
  stages            ProjectStage[]
  tasks             Task[]
  files             ProjectFile[]
  meetingReviews    MeetingReview[]
  timelineEvents    TimelineEvent[]
  receptions        Reception[]
  growthLogs        GrowthLog[]
  resumePoints      ResumePoint[]
  knowledgeNotes    KnowledgeNote[]
  feedbackQuestions FeedbackQuestion[]
  scheduleBlocks    ScheduleBlock[]
  trainingProfile   TrainingProfile?

  @@index([status])
  @@index([regionTagId])
  @@index([projectTypeTagId])
}

/// 培训项目专用台账：通用 Project 之外的业务字段
model TrainingProfile {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  currentPhase           String   @default("课程大纲")
  clientContactName      String?
  clientContactInfo      String?
  topicSource            String?
  topicCount             Int?
  participantCount       Int?
  totalDays              Float?
  dailyHours             Float?
  location               String?
  budget                 Float?
  currency               String   @default("CNY")
  costOwnership          String?
  internalCostNote       String?
  quoteRound             Int      @default(1)
  internalContractStatus String?
  clientContractStatus   String?
  depositNote            String?
  prepaymentPercent      Float?
  paymentMilestones      String?
  reportingStatus        String?
  postponed              Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItems TrainingChecklistItem[]

  @@index([currentPhase])
  @@index([postponed])
}

model TrainingChecklistItem {
  id                String   @id @default(cuid())
  trainingProfileId String
  section           String
  label             String
  done              Boolean  @default(false)
  note              String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainingProfile TrainingProfile @relation(fields: [trainingProfileId], references: [id], onDelete: Cascade)

  @@unique([trainingProfileId, section, label])
  @@index([trainingProfileId, section, sortOrder])
}

/// 联系人库：所有“人”的唯一数据源，别处只引用其 id
model Contact {
  id           String   @id @default(cuid())
  name         String
  organization String
  title        String?
  email        String?
  wechat       String?
  note         String?
  regionTagId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  regionTag         Tag?                 @relation("ContactRegion", fields: [regionTagId], references: [id], onDelete: SetNull)
  roles             ContactRoleMap[]
  projects          ProjectContact[]
  assignedTasks     Task[]               @relation("TaskAssignee")
  taskContacts      TaskContact[]
  stageContacts     StageContact[]
  receptionVisitors ReceptionVisitor[]
  teamMemberProfile TeamMemberProfile?
  sentRounds        MeetingReviewRound[] @relation("MeetingRoundSender")
  receivedRounds    MeetingReviewRound[] @relation("MeetingRoundReceiver")

  @@index([regionTagId])
}

model ContactRole {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  contacts ContactRoleMap[]
}

model ContactRoleMap {
  contactId String
  roleId    String

  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role    ContactRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([contactId, roleId])
}

model TeamMemberProfile {
  id           String  @id @default(cuid())
  contactId    String  @unique
  active       Boolean @default(true)
  capacityNote String?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
}

model ProjectContact {
  id        String             @id @default(cuid())
  projectId String
  contactId String
  side      ProjectContactSide
  isPrimary Boolean            @default(false)
  note      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@unique([projectId, contactId, side])
  @@index([projectId, side])
}

model StageTemplate {
  id               String   @id @default(cuid())
  name             String
  description      String?
  isDefault        Boolean  @default(false)
  projectTypeTagId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectTypeTag Tag?                @relation("StageTemplateProjectType", fields: [projectTypeTagId], references: [id], onDelete: SetNull)
  items          StageTemplateItem[]
  projects       Project[]           @relation("ProjectStageTemplate")
}

model StageTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  name        String
  sortOrder   Int
  description String?

  template      StageTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  projectStages ProjectStage[]

  @@unique([templateId, sortOrder])
}

/// 项目阶段：按模板生成，可单独改期/改状态（甘特图拖动改这里）
model ProjectStage {
  id                   String      @id @default(cuid())
  projectId            String
  sourceTemplateItemId String?
  name                 String
  sortOrder            Int
  plannedStart         DateTime?
  plannedEnd           DateTime?
  actualCompleted      DateTime?
  status               StageStatus @default(NOT_STARTED)
  note                 String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceTemplateItem StageTemplateItem? @relation(fields: [sourceTemplateItemId], references: [id], onDelete: SetNull)
  tasks              Task[]
  files              ProjectFile[]
  contacts           StageContact[]
  meetingReviews     MeetingReview[]

  @@unique([projectId, sortOrder])
  @@index([projectId, status])
}

model StageContact {
  stageId   String
  contactId String
  roleNote  String?

  stage   ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([stageId, contactId])
}

model Task {
  id          String     @id @default(cuid())
  /// 可为空：不挂项目的个人/行政事务（报销、入职手续等）
  projectId   String?
  stageId     String?
  typeTagId   String?
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  source      TaskSource @default(MANUAL)
  sourceRefId String?
  sourceLabel String?
  dueDate     DateTime?
  assigneeId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage            ProjectStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  typeTag          Tag?              @relation("TaskType", fields: [typeTagId], references: [id], onDelete: SetNull)
  assignee         Contact?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contacts         TaskContact[]
  feedbackFollowUp FeedbackQuestion? @relation("FeedbackFollowUp")

  @@unique([source, sourceRefId])
  @@index([projectId, status])
  @@index([stageId])
  @@index([assigneeId])
  @@index([source, status])
}

model TaskContact {
  taskId    String
  contactId String
  purpose   TaskContactPurpose

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([taskId, contactId, purpose])
}

model ProjectFile {
  id         String     @id @default(cuid())
  projectId  String
  stageId    String?
  fileTypeId String?
  name       String
  version    String?
  status     FileStatus @default(DRAFT)
  url        String?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage               ProjectStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  fileType            FileType?       @relation(fields: [fileTypeId], references: [id], onDelete: SetNull)
  finalForMeetingRuns MeetingReview[] @relation("FinalMeetingFile")

  @@index([projectId])
  @@index([stageId])
}

model MeetingReview {
  id          String              @id @default(cuid())
  projectId   String
  stageId     String?
  title       String
  status      MeetingReviewStatus @default(IN_PROGRESS)
  finalFileId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     ProjectStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  finalFile ProjectFile?         @relation("FinalMeetingFile", fields: [finalFileId], references: [id], onDelete: SetNull)
  rounds    MeetingReviewRound[]
}

model MeetingReviewRound {
  id                String            @id @default(cuid())
  reviewId          String
  roundNo           Int
  senderContactId   String?
  receiverContactId String?
  sentAt            DateTime?
  feedback          String?
  status            ReviewRoundStatus @default(PENDING)
  finalizedAt       DateTime?

  review   MeetingReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sender   Contact?      @relation("MeetingRoundSender", fields: [senderContactId], references: [id], onDelete: SetNull)
  receiver Contact?      @relation("MeetingRoundReceiver", fields: [receiverContactId], references: [id], onDelete: SetNull)

  @@unique([reviewId, roundNo])
}

/// 出差/接待/展会安排（type 区分三类）
model Reception {
  id        String          @id @default(cuid())
  projectId String?
  type      ReceptionType
  title     String
  location  String?
  purpose   String?
  startAt   DateTime?
  endAt     DateTime?
  status    ReceptionStatus @default(PLANNED)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  project        Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  visitors       ReceptionVisitor[]
  checklistItems ReceptionChecklistItem[]
}

/// 接待清单条目：按阶段（行前准备/抵达与现场/送行）跟踪每一项准备工作
model ReceptionChecklistItem {
  id          String    @id @default(cuid())
  receptionId String
  reception   Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  phase       String // 行前准备 / 抵达与现场 / 送行
  title       String
  done        Boolean   @default(false)
  ownerId     String? // 引用 Contact id（松引用，可空）
  dueDate     String? // ISO yyyy-mm-dd
  note        String?
  isMine      Boolean   @default(false) // 「我的」高亮
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([receptionId])
}

model ReceptionVisitor {
  receptionId String
  contactId   String

  reception Reception @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([receptionId, contactId])
}

model TimelineEvent {
  id         String   @id @default(cuid())
  projectId  String
  entityType String
  entityId   String?
  action     String
  message    String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Tag {
  id        String  @id @default(cuid())
  type      TagType
  name      String
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  projectsByRegion Project[]       @relation("ProjectRegion")
  projectsByType   Project[]       @relation("ProjectType")
  contactsByRegion Contact[]       @relation("ContactRegion")
  tasksByType      Task[]          @relation("TaskType")
  stageTemplates   StageTemplate[] @relation("StageTemplateProjectType")

  @@unique([type, name])
}

model FileType {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  enabled   Boolean @default(true)

  files ProjectFile[]
}

model TextTemplate {
  id        String       @id @default(cuid())
  name      String
  type      TemplateType
  content   String
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// 运行时配置（登录密码、AI 密钥等）：优先读这里，回退到环境变量。
/// 这样非技术用户可以在「设置」页改配置，不用碰 .env / Vercel 环境变量。
model AppSetting {
  id        String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AppPreference {
  id          String      @id @default("singleton")
  displayMode DisplayMode @default(ZH)
  updatedAt   DateTime    @updatedAt
}

/// 知识库：按主题积累专业知识（中微子/太赫兹/荧光检测…），可关联项目
model KnowledgeNote {
  id        String   @id @default(cuid())
  topic     String // 主题/领域，如「太赫兹」「电动汽车维保」
  title     String
  content   String // 知识正文/要点/术语对照
  url       String? // 外部资料链接
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([topic])
}

enum QuestionStatus {
  OPEN // 待整理/待发出
  SENT // 已发供应商，等回复
  ANSWERED // 已回复，待我判断
  UNCLEAR // 回复了但不清楚，需追问
  NEED_MEETING // 需要开会讲清楚
  CONFIRMED // 已确认关闭
}

/// 问题反馈清单：甲方提问→整理发供应商→判断回复→追问/开会→确认，逐条跟踪
model FeedbackQuestion {
  id             String         @id @default(cuid())
  projectId      String
  source         String         @default("甲方") // 甲方 / 供应商 / 我方
  question       String
  answer         String?
  note           String? // 追问点/待确认点
  followUpTaskId String?        @unique
  status         QuestionStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  followUpTask Task?   @relation("FeedbackFollowUp", fields: [followUpTaskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

/// 周计划时间块：日期 × 小时的日程（date 为空 = 每天重复的例行安排）
model ScheduleBlock {
  id           String    @id @default(cuid())
  title        String
  date         DateTime? // 具体某天；null = 每日例行（起床/通勤/午休…）
  startMin     Int // 从 0:00 起的分钟数，如 7:30 = 450
  endMin       Int
  kind         String    @default("work") // routine 例行 / work 工作
  location     String? // 地点
  participants String? // 参与人（自由文本，逗号分隔）
  note         String? // 备注 / 我的任务
  projectId    String? // 可选关联项目
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([date])
}

enum MoneyKind {
  SALARY // 工资到账
  ADVANCE // 垫付（待报销）
  REIMBURSED // 报销到账
  OTHER // 其他收支
}

/// 财务记录：工资、出差垫付、报销回款
model MoneyRecord {
  id         String    @id @default(cuid())
  kind       MoneyKind @default(ADVANCE)
  amount     Float // 金额（正数），方向由 kind 决定
  currency   String    @default("CNY")
  happenedAt DateTime  @default(now())
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([kind])
}

enum GrowthCategory {
  ACHIEVEMENT // 成果亮点（可直接写进简历）
  SKILL // 技能积累
  LESSON // 复盘/教训
  CERTIFICATE // 证书/培训
  NETWORK // 人脉资源
}

/// 成长档案：为职业发展/跳槽积累素材，可选关联项目
model GrowthLog {
  id         String         @id @default(cuid())
  category   GrowthCategory @default(ACHIEVEMENT)
  title      String
  detail     String?
  projectId  String?
  happenedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([category])
}

/// 已确认的中英文简历要点：由 AI 对话或手工整理后收藏，可关联项目复用。
model ResumePoint {
  id         String   @id @default(cuid())
  title      String
  chinese    String
  english    String
  sourceNote String?
  projectId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([updatedAt])
}

/// 通用资料库：公司模板、报销流程、接待讲解词等，不挂在具体项目下。
/// 文件本体一般放在网盘/Drive，这里存分类 + 链接；也可选上传到 Storage。
model Resource {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("其他")
  url       String?
  note      String?
  important Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}
